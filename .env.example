# Docker Compose environment variables (production)
# Copy to .env and fill in real values. Never commit the real .env.

# Database (service names resolve inside the compose network)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=irbis
DB_USER=postgres
DB_PASSWORD=change-me

# Redis (used by backend for rate-limiting store and session locks)
REDIS_PASSWORD=change-me

# Server
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=https://your-domain.example

# VAPID keys (generate with: npx web-push generate-vapid-keys  in server/)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
